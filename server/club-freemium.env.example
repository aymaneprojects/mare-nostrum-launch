# Copier vers /etc/club-freemium.env (chmod 600). Ne jamais versionner le vrai jeton.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Nom exact d'une table déjà existante. Ne pas en créer une nouvelle. Obligatoire.
AIRTABLE_TABLE_NAME=
# Noms des colonnes de cette table. Laisser ces valeurs si elles correspondent.
AIRTABLE_FIELD_EMAIL=email
AIRTABLE_FIELD_FIRST_NAME=first_name
AIRTABLE_FIELD_COMPANY=company
AIRTABLE_FIELD_LOCATION=location
RESEND_API_KEY=
