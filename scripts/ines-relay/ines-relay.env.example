# Copier vers /etc/ines-relay.env (chmod 600). NE JAMAIS versionner la vraie valeur.
RELAY_URL=https://oivxznyzijtoylwfigyq.supabase.co/functions/v1/chatbot-webhook
RELAY_TOKEN=<même valeur que le secret Supabase HERMES_RELAY_TOKEN>
RELAY_APIKEY=<clé publique Supabase (VITE_SUPABASE_PUBLISHABLE_KEY)>
HERMES_HOME=/root/.hermes/profiles/ines
HERMES_TOOLSETS=web,memory
PERSONA_FILE=/opt/ines-relay/ines-commerciale.md
# Repos quand aucun message n'attend. Ne pas descendre sous 15 : 2 secondes
# représentent environ 1,3 million d'appels par mois et coupent Supabase.
RELAY_POLL_SECONDS=15
# Pause (secondes) si Supabase répond 402 ou 429.
RELAY_BACKOFF_SECONDS=900
